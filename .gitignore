# .gitignore

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment (the example file is committed)
.env
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Google Cloud credentials
application_default_credentials.json
*-key.json

# Private local notes (study plan): never versioned
privado/
