# .env.example
# Template for local configuration. Copy it to .env (ignored by git) and adjust values.
# Never put secrets here: this file is committed.

# Google Cloud project ID where the lab's resources and Gemini calls are billed.
GOOGLE_CLOUD_PROJECT=python-gcp-ai-lab

# Location for Gemini calls on Vertex AI; "global" routes requests to the global endpoint.
GOOGLE_CLOUD_LOCATION=global

# PostgreSQL connection for SQLAlchemy async (asyncpg driver). This value matches the
# local docker compose database; inside compose the API uses host "db" instead.
DATABASE_URL=postgresql+asyncpg://quotes:quotes@localhost:5432/quotes
